; MATERIAL=tpu-72d
; MATERIAL_PROVENANCE=generator-selected spool identity; maintained in machine.MATERIAL_TEMP
; LAYER_H=0.42
; LAYER_H_PROVENANCE=generator-emitted Z-step geometry
; FLOW=VARIABLE:5.833..9
; FLOW_PROVENANCE=generator-calculated delivered bead cross-section x feedrate
; HEADER_PROVENANCE=machine.emit_gcode
; BRIDGE-TPU-1 row R2: five post pairs, 0.82x0.42 bead, spans 4,7,10,13,16.8 mm, a one-bead bridge every 10 laps
; PRINTER=k2plus
; CMD=bridge_tpu.py --row R2 --over-limit
; SPEED=26.1324
;   min(50, 9 mm3/s / (0.82*0.42)) -- verdict WV 78; Orca cap 15 mm3/s (/Users/olegmalkov/Library/Application Support/OrcaSlicer/user/default/filament/72D TPU 0.4.json)
; WALL=postbridge
; NOZZLE=0.4  (K2Plus-569A per memory printer-fleet-access; Orca's own K2Plus-569A machine preset inherits the 0.6 base -- read the nozzle from Oleg before sending)
; bead 0.82x0.42
; BEAD_OVERRIDE=0.82x0.42 over the 0.6x0.3 ceilings, declared with --over-limit: his Orca 'orca default' line/layer (memory hanger-family-is-tpu-72d)
; PRESSED_LAYER1=0.1
; LAYER1_WIDTH=0.93mm landed at 0.24: machine.PROVEN_LAYER1['k2plus'] (0.24, 0.93), an entry that table marks ORDERED, NOT YET READ
; PRINT_TEMP=270  (Orca nozzle_temperature, /Users/olegmalkov/Library/Application Support/OrcaSlicer/user/default/filament/72D TPU 0.4.json; machine.MATERIAL_TEMP says 245 -- disagreement stamped)
; BED_TEMP=70  (Orca hot_plate_temp, /Users/olegmalkov/Library/Application Support/OrcaSlicer/user/default/filament/72D TPU 0.4.json; machine.BED_TEMP says 50)
; FAN: Orca fan_max_speed 100% (/Applications/OrcaSlicer.app/Contents/Resources/profiles/Creality/filament/fdm_filament_tpu.json), close_fan_the_first_x_layers 1, additional_cooling_fan_speed 70% -- emitted FULL on every layer and both aux fans, because validate.py's TPU guard requires it
; PROBE_TEMP=140
; HEAD_R=50 (UNVERIFIED) -- the other row sits 85 mm away edge to edge
; POST pair=0 A=224.000,143.000,228.000,147.000 B=232.000,143.000,236.000,147.000 clear=4
; POST pair=1 A=222.500,158.000,226.500,162.000 B=233.500,158.000,237.500,162.000 clear=7
; POST pair=2 A=221.000,173.000,225.000,177.000 B=235.000,173.000,239.000,177.000 clear=10
; POST pair=3 A=219.500,188.000,223.500,192.000 B=236.500,188.000,240.500,192.000 clear=13
; POST pair=4 A=217.600,203.000,221.600,207.000 B=238.400,203.000,242.400,207.000 clear=16.8
; 48 laps, top at 19.98 mm; bridges at laps 10,20,30,40 (4 levels, not 5: 20 mm at 0.42 holds only 4)
; READ IT: per span, mid-span sag vs 1 lh, hand-pull at the post, is the bridge above clean.
; HEADER_BLOCK_START
; total layer number: 48
; HEADER_BLOCK_END
M82
G90
M140 S70
M104 S140                          ; the probe/clean temperature, theirs
G28                                ; coarse, with whatever is on the tip
NOZZLE_CLEAR                       ; their scrub of the nozzle on the plate
TEMPERATURE_WAIT SENSOR=extruder MINIMUM=130 MAXIMUM=150
G28 Z                              ; zero again on the scrubbed tip
BED_MESH_PROFILE LOAD=default      ; G28 cleared it; put the saved mesh back
M104 S270
BOX_GO_TO_EXTRUDE_POS              ; heat in the purge box behind the plate (133,378)
TEMPERATURE_WAIT SENSOR=extruder MINIMUM=260 MAXIMUM=280
G91
G1 E60 F300                       ; BOX PURGE, stationary by design: the box wipe is the far end
G1 E-8 F180                        ; BOX PURGE, pull back so the tip stops weeping
G90
BOX_NOZZLE_CLEAN                   ; their wipe again, at print temp, as START_PRINT does
M190 S70
SET_GCODE_OFFSET Z=0
SET_GCODE_OFFSET Z=-0.010 MOVE=0   ; commanded 0.1 + this + zerr +0.150 = 0.24
M106 S255
SET_PIN PIN=fan1 VALUE=255
SET_PIN PIN=fan2 VALUE=255
G92 E0
; PRIME  2 rows x 71.0mm on the right of the mesh, 144.9mm of path, ALL OF IT PINNED -- no stationary extrusion at any Z (validate R10)
; PRIME  purge 5mm of filament over the first 44.9mm at 1.2x layer 1, then layer 1's own 0.09280mm/mm as a first-layer WITNESS
G0 F7200 Z1.100   ; PRIME-TRAVEL lift, nothing on the plate yet
G0 F7200 X335.000 Y85.951   ; PRIME-TRAVEL to the prime start
G1 F600 Z0.100   ; PRIME descend to the press gap -- the prime prints at the PART's gap, so a thin or broken line here is the first layer failing in 8 seconds, not in 6 hours
G1 F1568 X335.000 Y41.049 E5.00000   ; PRIME lead-in, purge
G1 F1568 X335.000 Y15.000 E7.41726   ; PRIME witness, layer 1's own rate
G1 F1568 X332.000 Y15.000 E7.69565   ; PRIME witness, layer 1's own rate
G1 F1568 X332.000 Y65.951 E12.42366   ; PRIME witness, layer 1's own rate
G1 F1568 X332.000 Y70.951 E12.70205   ; PRIME taper 0.60x -- pressure decays while motion continues
G1 F1568 X332.000 Y75.951 E12.84124   ; PRIME taper 0.30x -- pressure decays while motion continues
G1 F1568 X332.000 Y80.951 E12.88764   ; PRIME taper 0.10x -- pressure decays while motion continues
G1 F1568 X332.000 Y85.951 E12.88764   ; PRIME taper 0.00x -- pressure decays while motion continues
G0 F7200 X332.000 Y67.951   ; PRIME break-off wipe -- 18mm back over the taper, E frozen, ironing the tail into sacrificial material
G0 F7200 X332.000 Y97.951   ; PRIME break-off -- out onto the reserved 12mm of clear plate; a drawn thread necks as 1/v, so this runs at travel speed and not the F3000 the old break-off used
G92 E0

; SIGNS DESK-LOGO PROOF — 240x96x18mm indoor lightbox body
; STAGE=PHYSICAL PROOF FILE; design gate passed does not mean printed or tested
; CMD=python3 signs/desk_logo.py
; PRINTER=k2plus
; MATERIAL=pla
; LAYER_H=0.4
; SPEED=25.0000
; SPEED_LAYER1=25.0000
; FLOW=12.0000
; PRESSED_LAYER1=0.1
; LAYER1_WIDTH=2.00mm landed in the 0.1 gap
; PRINT_TEMP=210
; PROOF_GEOMETRY=solid back 1.3mm; double return ~2.4mm; LED raceway 12mm; retention rail 2.4mm
; FLOW_DERATE=accurate wall placement: 1.2x0.4mm bead at 25mm/s = 12mm3/s; this proof values straight, aligned light-sealing returns over maximum throughput
; FACE=separate diffuser/removable face not included in this body proof
; USE=movable indoor low-voltage desk object only
; MATERIAL=78.3g / 63.14cm3 from final emitted E
M82
G90
M140 S80
M104 S210
G28
SET_GCODE_OFFSET Z=-0.150 ; first layer lands at 0.1mm
M190 S80
M109 S210
M106 S0
SET_PIN PIN=fan1 VALUE=0
SET_PIN PIN=fan2 VALUE=0
G92 E0
; PRIME  2 rows x 73.6mm on the left of the mesh, 150.1mm of path, ALL OF IT PINNED -- no stationary extrusion at any Z (validate R10)
; PRIME  purge 5mm of filament over the first 50.1mm at 1.2x layer 1, then layer 1's own 0.08315mm/mm as a first-layer WITNESS
G0 F7200 Z1.100   ; PRIME-TRAVEL lift, nothing on the plate yet
G0 F7200 X15.000 Y88.555   ; PRIME-TRAVEL to the prime start
G1 F600 Z0.100   ; PRIME descend to the press gap -- the prime prints at the PART's gap, so a thin or broken line here is the first layer failing in 8 seconds, not in 6 hours
G1 F1500 X15.000 Y38.445 E5.00000   ; PRIME lead-in, purge
G1 F1500 X15.000 Y15.000 E6.94946   ; PRIME witness, layer 1's own rate
G1 F1500 X18.000 Y15.000 E7.19891   ; PRIME witness, layer 1's own rate
G1 F1500 X18.000 Y68.555 E11.65203   ; PRIME witness, layer 1's own rate
G1 F1500 X18.000 Y73.555 E11.90148   ; PRIME taper 0.60x -- pressure decays while motion continues
G1 F1500 X18.000 Y78.555 E12.02620   ; PRIME taper 0.30x -- pressure decays while motion continues
G1 F1500 X18.000 Y83.555 E12.06778   ; PRIME taper 0.10x -- pressure decays while motion continues
G1 F1500 X18.000 Y88.555 E12.06778   ; PRIME taper 0.00x -- pressure decays while motion continues
G0 F7200 X18.000 Y70.555   ; PRIME break-off wipe -- 18mm back over the taper, E frozen, ironing the tail into sacrificial material
G0 F7200 X18.000 Y100.555   ; PRIME break-off -- out onto the reserved 12mm of clear plate; a drawn thread necks as 1/v, so this runs at travel speed and not the F3000 the old break-off used
G92 E0
; BODY_START
G0 Z2.100 F1800 ; HOP back L1 row 1
G0 X90.864 Y129.180 F7200 ; HOP back L1 row 1
G1 Z0.100 F600
G1 F1500 X259.136 Y129.180 Z0.100 E13.99191

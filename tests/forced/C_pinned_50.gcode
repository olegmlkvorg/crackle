; CROWNED PULLEY — OD 80.0mm, 12.0mm wide, 6.0mm D-bore
; web: 2 spokes per layer (rim -> spiral in -> bore -> spiral out), rotating 0.0166 rad/layer
; crown +0.6mm at mid-height (self-centres a flat belt), flange +2.5mm at the ends
; bead 6.0x0.6 at 15.3 mm/s (north star 50, lowered only by this bead/flow) -> flow=55.0 mm3/s, 20 layers
; layer 1: SAME flow, SAME 15.3 mm/s, pressed to Z0.10 — the bead spreads to ~36.0mm and that squished footprint is the adhesion
; HEADER_BLOCK_START
; total layer number: 20
; HEADER_BLOCK_END
M140 S90.0
M104 S230
G90
G28
TEMPERATURE_WAIT SENSOR='heater_bed' MINIMUM=60 MAXIMUM=95.0
M109 S230
M204 S8000
M107                              ; layer 1: no part cooling, let it bond
SET_FAN_SPEED FAN=side_fan SPEED=0.20
SET_FAN_SPEED FAN=chassis_fan SPEED=0.20
M82
G92 E0
G1 Z0.100 F600
G0 F9000 X107.500 Y110.000
G1 E25 F300                      ; stationary purge — pressure before motion
G1 F1200 X152.500 Y110.000 E37   ; PRIME line — ends where the rim begins
G92 E0
; MATERIAL=pla-matte
; LAYER_H=0.6
; FLOW=54.960
